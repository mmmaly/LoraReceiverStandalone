+    float snr; float cfo;
+};
+
+class LoRaRxPacketMessage : public Message {
+   public:
+    constexpr LoRaRxPacketMessage(LoRaPacketData* packet) : Message{ID::LoRaRxPacket}, packet{packet} {}
